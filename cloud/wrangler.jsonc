{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "level-up-cloud-api",
  "main": "src/fatsecret-diagnostic-worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": [
      "FATSECRET_CLIENT_ID",
      "FATSECRET_CLIENT_SECRET",
      "USDA_FDC_API_KEY",
      "APPLE_TEAM_ID",
      "APPLE_KEY_ID",
      "APPLE_PRIVATE_KEY",
      "APPLE_TOKEN_ENCRYPTION_KEY"
    ]
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "969450620287-gh455asc7c3lh67j7llq6f55rdpla0j3.apps.googleusercontent.com",
    "APPLE_CLIENT_ID": "com.leveluphypertrophy.app",
    "ALLOWED_ORIGINS": "https://leveluphypertrophy.com,https://www.leveluphypertrophy.com,https://app.leveluphypertrophy.com,https://admin.leveluphypertrophy.com,https://jrgallop-code.github.io,capacitor://localhost",
    "ANALYTICS_TIME_ZONE": "America/Halifax"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "level-up-beta",
      "database_id": "f3a70957-c09d-4397-a65e-3c22e9578d7b",
      "migrations_dir": "migrations"
    }
  ]
}
