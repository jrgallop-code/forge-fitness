export function getExerciseById(id) {

    return exercises.find(
        exercise =>
            exercise.id === id
    );

}


export function getExerciseGroups() {

    return [
        ...new Set(
            exercises.map(
                exercise =>
                    exercise.muscleGroup
            )
        )
    ];

}